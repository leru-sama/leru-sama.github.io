&lt;p>这是一张图，放在/static/img目录下面的，不知道为什么，用figure短代码显示不出来：&lt;/p>
&lt;p>&lt;img alt="测试图片" loading="lazy" src="https://leru-sama.github.io/img/test_photo.jpg">&lt;/p>
&lt;p>这是一张图，和这个md文档放一起的，这个就能显示出来：&lt;/p>
&lt;figure>
&lt;img loading="lazy" src="https://leru-sama.github.io/example/test.jpg"
alt="测试图片"onclick="openImageViewer(this)"
style="cursor: pointer;"
/> &lt;figcaption>
&lt;p>这是一张测试图片&lt;/p>
&lt;/figcaption>
&lt;/figure>
&lt;style>
.image-viewer {
display: none;
position: fixed;
top: 0;
left: 0;
width: 100%;
height: 100%;
background-color: rgba(0, 0, 0, 0.9);
z-index: 9999;
justify-content: center;
align-items: center;
}
.image-viewer.show {
display: flex;
}
.image-viewer img {
max-width: 90%;
max-height: 90%;
object-fit: contain;
}
.image-viewer-close {
position: absolute;
top: 20px;
right: 30px;
color: white;
font-size: 40px;
font-weight: bold;
cursor: pointer;
transition: 0.3s;
}
.image-viewer-close:hover {
color: #bbb;
}
&lt;/style>
&lt;script>
function createImageViewer() {
if (!document.getElementById('imageViewer')) {
const viewer = document.createElement('div');
viewer.id = 'imageViewer';
viewer.className = 'image-viewer';
viewer.innerHTML = `
&lt;span class="image-viewer-close" onclick="closeImageViewer()">&amp;times;&lt;/span>
&lt;img id="viewerImage" src="" alt="放大图片">
`;
document.body.appendChild(viewer);
viewer.addEventListener('click', function(event) {
if (event.target === viewer) {
closeImageViewer();
}
});
document.addEventListener('keydown', function(event) {
if (event.key === 'Escape' &amp;&amp; viewer.classList.contains('show')) {
closeImageViewer();
}
});
}
return document.getElementById('imageViewer');
}
function openImageViewer(imgElement) {
const viewer = createImageViewer();
const viewerImg = document.getElementById('viewerImage');
viewerImg.src = imgElement.src;
viewerImg.alt = imgElement.alt;
viewer.classList.add('show');
document.body.style.overflow = 'hidden';
}
function closeImageViewer() {
const viewer = document.getElementById('imageViewer');
if (viewer) {
viewer.classList.remove('show');
document.body.style.overflow = '';
}
}
&lt;/script>
