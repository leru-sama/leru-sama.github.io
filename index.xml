&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span> led &lt;span style="color:#f92672">&amp;lt;=&lt;/span> &lt;span style="color:#ae81ff">8&lt;/span>&lt;span style="color:#ae81ff">&amp;#39;b00000000&lt;/span>;
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span> &lt;span style="color:#66d9ef">end&lt;/span> &lt;span style="color:#66d9ef">else&lt;/span> &lt;span style="color:#66d9ef">begin&lt;/span>
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span> led &lt;span style="color:#f92672">&amp;lt;=&lt;/span> led &lt;span style="color:#f92672">+&lt;/span> &lt;span style="color:#ae81ff">1&lt;/span>&lt;span style="color:#ae81ff">&amp;#39;b1&lt;/span>;
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span> &lt;span style="color:#66d9ef">end&lt;/span>
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span>&lt;span style="color:#66d9ef">end&lt;/span>
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span>
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span>&lt;span style="color:#66d9ef">endmodule&lt;/span>
&lt;/span>&lt;/span>&lt;/code>&lt;/pre>&lt;/div>&lt;p>内嵌公式，支持latex语法！
例如：$E=mc^2$&lt;/p>
&lt;p>还有独占一行的公式！&lt;/p>
&lt;p>$$
F(x) = \int_{-\infty}^\infty e^{-x^2} dx
$$&lt;/p>
&lt;p>这是一张图，放在/static/img目录下面的，不知道为什么，用figure短代码显示不出来：&lt;/p>
&lt;p>&lt;img alt="测试图片" loading="lazy" src="https://leru-sama.github.io/img/test_photo.jpg">&lt;/p>
&lt;p>这是一张图，和这个md文档放一起的，这个就能显示出来：&lt;/p>
&lt;figure>
&lt;img loading="lazy" src="https://leru-sama.github.io/example/test.jpg"
alt="测试图片"onclick="openImageViewer(this)"
style="cursor: pointer;"
/> &lt;figcaption>
&lt;p>这是一张测试图片&lt;/p>
&lt;/figcaption>
&lt;/figure>
&lt;style>
.image-viewer {
display: none;
position: fixed;
top: 0;
left: 0;
width: 100%;
height: 100%;
background-color: rgba(0, 0, 0, 0.9);
z-index: 9999;
justify-content: center;
align-items: center;
}
.image-viewer.show {
display: flex;
}
.image-viewer img {
max-width: 90%;
max-height: 90%;
object-fit: contain;
}
.image-viewer-close {
position: absolute;
top: 20px;
right: 30px;
color: white;
font-size: 40px;
font-weight: bold;
cursor: pointer;
transition: 0.3s;
}
.image-viewer-close:hover {
color: #bbb;
}
&lt;/style>
&lt;script>
function createImageViewer() {
if (!document.getElementById('imageViewer')) {
const viewer = document.createElement('div');
viewer.id = 'imageViewer';
viewer.className = 'image-viewer';
viewer.innerHTML = `
&lt;span class="image-viewer-close" onclick="closeImageViewer()">&amp;times;&lt;/span>
&lt;img id="viewerImage" src="" alt="放大图片">
`;
document.body.appendChild(viewer);
viewer.addEventListener('click', function(event) {
if (event.target === viewer) {
closeImageViewer();
}
});
document.addEventListener('keydown', function(event) {
if (event.key === 'Escape' &amp;&amp; viewer.classList.contains('show')) {
closeImageViewer();
}
});
}
return document.getElementById('imageViewer');
}
function openImageViewer(imgElement) {
const viewer = createImageViewer();
const viewerImg = document.getElementById('viewerImage');
viewerImg.src = imgElement.src;
viewerImg.alt = imgElement.alt;
viewer.classList.add('show');
document.body.style.overflow = 'hidden';
}
function closeImageViewer() {
const viewer = document.getElementById('imageViewer');
if (viewer) {
viewer.classList.remove('show');
document.body.style.overflow = '';
}
}
&lt;/script>
