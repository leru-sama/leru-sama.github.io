&lt;i class="fas fa-code">&lt;/i>
显示文本
&lt;/a>
&lt;/code>&lt;/pre>&lt;h2 id="参数说明">参数说明&lt;/h2>
&lt;table>
&lt;thead>
&lt;tr>
&lt;th>参数&lt;/th>
&lt;th>类型&lt;/th>
&lt;th>必需&lt;/th>
&lt;th>说明&lt;/th>
&lt;/tr>
&lt;/thead>
&lt;tbody>
&lt;tr>
&lt;td>&lt;code>path&lt;/code>&lt;/td>
&lt;td>字符串&lt;/td>
&lt;td>✅&lt;/td>
&lt;td>相对于 &lt;code>static/code/&lt;/code> 的路径，支持深层目录结构&lt;/td>
&lt;/tr>
&lt;tr>
&lt;td>&lt;code>text&lt;/code>&lt;/td>
&lt;td>字符串&lt;/td>
&lt;td>❌&lt;/td>
&lt;td>链接显示的文本，默认为路径&lt;/td>
&lt;/tr>
&lt;tr>
&lt;td>&lt;code>line&lt;/code>&lt;/td>
&lt;td>数字&lt;/td>
&lt;td>❌&lt;/td>
&lt;td>行号，会在URL中添加锚点&lt;/td>
&lt;/tr>
&lt;/tbody>
&lt;/table>
